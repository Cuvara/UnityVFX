# Normalise text to LF so hashes recorded in recipes and stats do not depend on the checkout OS.
* text=auto eol=lf

# Unity text assets and metadata: LF (Unity writes LF; force-text serialization).
*.meta text eol=lf
*.cs text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.vfx text eol=lf
*.vfxoperator text eol=lf
*.vfxblock text eol=lf
*.prefab text eol=lf merge=unityyamlmerge
*.unity text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary assets: never normalise, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary
*.gif binary
*.fbx binary
*.glb binary
*.gltf text eol=lf
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.dll binary
*.so binary
*.zip binary
*.unitypackage binary
*.ttf binary
*.otf binary
*.cubemap binary
*.flare text eol=lf
