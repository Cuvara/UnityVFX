  stickyNoteInfos:
  - title: ChainTargets
    position:
      serializedVersion: 2
      x: 480
      y: 100
      width: 320
      height: 180
    contents: 'Test fixture of com.cuvara.vfx: exposes the default properties of ChainLightningBinder (SourcePosition, TargetPosition0 to TargetPosition7, HopCount) and draws one burst of quads on the line from SourcePosition to TargetPosition7, which the binder sets to the last valid target.'
    theme: Classic
    textSize: Small
    colorTheme: 0
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
